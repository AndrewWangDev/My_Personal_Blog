{
	"name": "my_website",
	"compatibility_date": "2024-05-11",
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my_website_db",
			"database_id": "YOUR_D1_DATABASE_ID",
			"preview_database_id": "DB"
		}
	]
}
